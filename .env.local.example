DB_NAME=short_video_agent_local
DB_USERNAME=root
DB_PASSWORD=
REDIS_PASSWORD=
LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_REDIS_HOST=127.0.0.1
LOCAL_REDIS_PORT=6379
LOCAL_QDRANT_PORT=16333
LOCAL_QDRANT_GRPC_PORT=16334
LOCAL_AI_PORT=18000
LOCAL_BACKEND_PORT=18080
LOCAL_FRONTEND_PORT=5178
AI_MODE=real
AI_HTTP_RETRIES=4
# 可选：有 VPN 或多网卡时，指定菜单展示的内网 IPv4；默认自动检测。
# LOCAL_LAN_IP=192.168.1.100
REGISTRATION_MAX_ATTEMPTS=100
# 可执行文件可用相对项目根目录的路径；不填时自动查找或下载。
# LOCAL_QDRANT_BIN=tools/qdrant.exe
# LOCAL_AI_PYTHON=tools/python/python.exe
# Windows：自动检测已注册的 MySQL / Redis / Memurai 服务。
# 多个匹配服务时，通过下面两个配置指定；Linux 可填 systemd 服务名。
# LOCAL_MYSQL_SERVICE=MySQL80
# LOCAL_REDIS_SERVICE=Redis
