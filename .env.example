# Copy via scripts/setup-env.sh. Keep this file free of actual credentials.
WEB_PORT=8088
MYSQL_ROOT_PASSWORD=
DB_NAME=short_video_agent
DB_USERNAME=short_video
DB_PASSWORD=
REDIS_PASSWORD=
AI_INTERNAL_KEY=
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
# real is the default. demo is explicit synthetic generation and embeddings.
AI_MODE=real
GENERATION_BASE_URL=https://api.example.com/v1
GENERATION_API_KEY=
GENERATION_MODEL=
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
QDRANT_COLLECTION=short_video_knowledge
AI_HTTP_TIMEOUT_SECONDS=120
AI_HTTP_RETRIES=2
RETRIEVAL_MIN_SCORE=0.2

# Production registration protection; local previews may use a higher quota.
REGISTRATION_MAX_ATTEMPTS=10
REGISTRATION_WINDOW_SECONDS=3600
